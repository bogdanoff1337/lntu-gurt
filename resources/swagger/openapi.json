{
    "openapi": "3.0.0",
    "info": {
        "title": "LNTU Gurt API",
        "version": "v1",
        "description": "Документація для фронтендерів"
    },
    "servers": [
        {
            "url": "http://localhost/api"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "summary": "Авторизація студента",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "email": { "type": "string", "example": "student@example.com" },
                                    "password": { "type": "string", "example": "password123" }
                                },
                                "required": ["email", "password"]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успішна авторизація"
                    }
                }
            }
        },
        "/auth/register": {
            "post": {
                "summary": "Реєстрація нового студента",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "email": { "type": "string" },
                                    "password": { "type": "string" },
                                    "password_confirmation": { "type": "string" }
                                },
                                "required": ["name", "email", "password", "password_confirmation"]
                            }
                        }
                    }
                },
                "responses": {
                    "201": { "description": "Створено" }
                }
            }
        },
        "/auth/me": {
            "post": {
                "summary": "Поточний користувач",
                "security": [{ "bearerAuth": [] }],
                "responses": {
                    "200": {
                        "description": "Дані користувача"
                    }
                }
            }
        },
        "/dormitories": {
            "get": {
                "summary": "Список гуртожитків",
                "security": [{ "bearerAuth": [] }],
                "responses": {
                    "200": { "description": "Список гуртожитків" }
                }
            }
        },
        "/faculties": {
            "get": {
                "summary": "Список факультетів",
                "security": [{ "bearerAuth": [] }],
                "responses": {
                    "200": { "description": "Список факультетів" }
                }
            }
        },
        "/cities": {
            "get": {
                "summary": "Список міст",
                "security": [{ "bearerAuth": [] }],
                "responses": {
                    "200": { "description": "Список міст" }
                }
            }
        },
        "/rooms": {
            "get": {
                "summary": "Список кімнат",
                "security": [{ "bearerAuth": [] }],
                "responses": {
                    "200": { "description": "Список кімнат" }
                }
            },
            "post": {
                "summary": "Створити кімнату",
                "security": [{ "bearerAuth": [] }],
                "responses": {
                    "201": { "description": "Кімната створена" }
                }
            }
        },
        "/profile/me": {
            "patch": {
                "summary": "Оновити профіль",
                "security": [{ "bearerAuth": [] }],
                "responses": {
                    "200": { "description": "Профіль оновлено" }
                }
            }
        },
        "/email/verify/{id}": {
            "get": {
                "summary": "Підтвердити email",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": { "description": "Email підтверджено" }
                }
            }
        },
        "/email/send": {
            "get": {
                "summary": "Надіслати повторно лист підтвердження",
                "responses": {
                    "200": { "description": "Надіслано" }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT"
            }
        }
    }
}
